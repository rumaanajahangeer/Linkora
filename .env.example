# Local development (SQLite file on this machine only — not reachable from phones)
DATABASE_URL="file:./dev.db"
JWT_SECRET="your_jwt_secret_key_here"

# Public site URL used in copied/shared short links.
# On Vercel this is auto-detected (VERCEL_URL / request Host). Never set this to localhost, 127.0.0.1, or a LAN IP in production.
# NEXT_PUBLIC_APP_URL="https://your-app.vercel.app"

# Production on Vercel: use hosted Postgres (Neon, Vercel Postgres, etc.). SQLite will not persist.
# DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
